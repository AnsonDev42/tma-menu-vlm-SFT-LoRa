# Absolute path to private training data stored outside this repository.
MENU_DATASET_PATH=/absolute/path/to/menu-training-data
# External generated SFT dataset; never place it in Git.
MENU_COMPILED_PATH=/absolute/path/to/qwen3-vl-sft-v1
# Explicit local-only current-TMA evaluation source and imported test artifact.
TMA_DATA_ROOT=/absolute/path/to/tma-menu-parser-data
TMA_LUNA_EVALUATION_RUN=completed-current-luna-run
LUNA_TEST_PREDICTIONS=/absolute/path/to/luna-test-predictions.jsonl
# Secrets are read from the environment by runpodctl; do not commit a value.
RUNPOD_API_KEY=
